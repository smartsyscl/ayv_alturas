generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum QuoteStatus {
  PENDING
  REPLIED
  CLOSED
}

enum PaymentStatus {
  NOT_APPLICABLE
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  TRANSFER
  WEBPAY
  OTHER
}

model Quote {
  id            String      @id @default(cuid())
  contactName   String
  contactRole   String?
  clientEmail   String
  clientPhone   String
  buildingType  String?
  propertyType  String?
  siteAddress   String
  addressDetail String?
  serviceId     String
  serviceLabel  String
  floors        Int?
  status        QuoteStatus @default(PENDING)
  adminResponse String?
  respondedAt   DateTime?
  respondedBy   String?     // Email o username del admin que respondió
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Campos de medidas y precio (v2)
  measurements    Json?   // { "interiorM2": 50, "fachadaM2": 30, "puertasQty": 4 }
  requestVisit    Boolean @default(false)
  calculatedPrice Int?    // Precio total calculado en CLP (centavos no aplican en CLP)

  // Campos de pago
  paymentStatus  PaymentStatus @default(NOT_APPLICABLE)
  paymentMethod  PaymentMethod?
  paymentAmount  Int?          // Monto pagado en CLP
  paymentDate    DateTime?     // Fecha del último pago
  paymentDueDate DateTime?     // Fecha de vencimiento del pago
  paymentNote    String?       // Nota interna sobre el pago

  @@index([clientEmail])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([paymentStatus])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]
}
